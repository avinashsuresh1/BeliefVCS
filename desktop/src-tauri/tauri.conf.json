{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/refs/heads/v2/crates/tauri-cli/schema.json",
  "productName": "library4agents-desktop",
  "version": "0.1.0",
  "identifier": "com.library4agents.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Agent Observability & Model Cockpit",
        "width": 1320,
        "height": 880,
        "resizable": true,
        "minWidth": 960,
        "minHeight": 640
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; style-src 'self' 'unsafe-inline' https://cdn.tailwindcss.com; connect-src 'self' ipc: http://localhost:* http://127.0.0.1:* https:; img-src 'self' data:;"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
